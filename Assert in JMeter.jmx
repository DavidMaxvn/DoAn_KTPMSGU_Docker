    &lt;bookingdates&gt;&#xd;
      &lt;checkin&gt;2018-01-01&lt;/checkin&gt;&#xd;
      &lt;checkout&gt;2019-01-01&lt;/checkout&gt;&#xd;
    &lt;/bookingdates&gt;&#xd;
    &lt;additionalneeds&gt;Breakfast&lt;/additionalneeds&gt;&#xd;
  &lt;/booking&gt;</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
